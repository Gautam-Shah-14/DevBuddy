  "description": "A CLI developer assistant powered by your own local Ollama installation",
  "type": "module",
  "bin": {
    "devbuddy": "./bin/devbuddy.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/**/*.test.ts"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
