    "type": "git",
    "url": "git+https://github.com/Gautam-Shah-14/DevBuddy.git"
  },
  "homepage": "https://github.com/Gautam-Shah-14/DevBuddy#readme",
  "bugs": {
    "url": "https://github.com/Gautam-Shah-14/DevBuddy/issues"
  },
  "author": "TokenBurners",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.11.4",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
